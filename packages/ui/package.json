{
  "name": "@better-tables/ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI components for Better Tables - Beautiful, accessible table components built with shadcn/ui",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "clean": "git clean -xdf .cache dist .turbo node_modules"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-tables/core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "catalog:",
    "lucide-react": "catalog:",
    "lz-string": "catalog:",
    "react-day-picker": "^10.0.1",
    "shadcn": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss-animate": "catalog:",
    "tw-animate-css": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.4.21",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "better-tables",
    "table",
    "data-table",
    "react",
    "shadcn",
    "ui",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Better-Tables/better-tables.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Better-Tables/better-tables/issues"
  },
  "homepage": "https://github.com/Better-Tables/better-tables#readme"
}
