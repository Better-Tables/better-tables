{
  "name": "@better-tables/adapters-toolkit",
  "version": "0.1.0",
  "description": "ORM-agnostic adapter toolkit for Better Tables - shared primitives for building table adapters",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache dist .turbo node_modules"
  },
  "peerDependencies": {
    "@better-tables/core": "workspace:*"
  },
  "devDependencies": {
    "@better-tables/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "mitata": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "table",
    "data-table",
    "data-grid",
    "adapter",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Better-Tables/better-tables",
    "directory": "packages/adapters/toolkit"
  },
  "bugs": {
    "url": "https://github.com/Better-Tables/better-tables/issues"
  },
  "homepage": "https://github.com/Better-Tables/better-tables#readme"
}
