# Local Database Connection Strings for Testing
#
# Integration tests only — the SQLite test suites need nothing (they run
# against an in-memory/temp-file SQLite database with no env vars). Only
# copy this file (to .env.local) and fill in credentials if you're running
# the MySQL/Postgres integration suites in packages/adapters/drizzle/tests/.

# MySQL Connection
# Format: mysql://user:password@host:port/database
MYSQL_TEST_URL=mysql://username:password@localhost:3306/better_tables_test

# PostgreSQL Connection
# Format: postgresql://user:password@host:port/database
POSTGRES_TEST_URL=postgresql://postgres:password@localhost:5432/drizzle_test
