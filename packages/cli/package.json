{
  "name": "@better-tables/cli",
  "version": "0.2.0",
  "description": "Command-line utilities for Better Tables",
  "type": "module",
  "bin": {
    "better-tables": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "ui-src"
  ],
  "scripts": {
    "build": "tsdown && bun scripts/bundle-ui-src.ts",
    "dev": "tsdown --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache dist .turbo node_modules"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "open": "^11.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "better-tables",
    "cli",
    "command-line",
    "table",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Better-Tables/better-tables",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Better-Tables/better-tables/issues"
  },
  "homepage": "https://github.com/Better-Tables/better-tables#readme",
  "engines": {
    "node": ">=20.19.0"
  }
}
