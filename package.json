{
  "name": "@better-tables/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A comprehensive React table library with advanced filtering",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/adapters/*",
      "apps/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.6.0",
      "@biomejs/biome": "2.3.11",
      "@date-fns/tz": "^1.5.0",
      "@tailwindcss/postcss": "^4.1.18",
      "@types/better-sqlite3": "^7.6.13",
      "@types/node": "^25.0.9",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "better-sqlite3": "^12.4.6",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "date-fns": "^4.1.0",
      "drizzle-orm": "^0.45.1",
      "lucide-react": "^0.562.0",
      "lz-string": "^1.5.0",
      "next": "^16.1.3",
      "postcss": "^8.5.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "shadcn": "^4.13.0",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.1.18",
      "tailwindcss-animate": "^1.0.7",
      "tsdown": "^0.16.6",
      "tw-animate-css": "^1.4.0",
      "typescript": "^5.9.3",
      "zustand": "^5.0.14",
      "@happy-dom/global-registrator": "^17.0.0",
      "@testing-library/dom": "^10.4.0",
      "@testing-library/react": "^16.3.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev",
    "dev:run": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "lint": "biome check --write --unsafe .",
    "changeset": "changeset",
    "changeset:version": "changeset version && bun install",
    "release": "bun i && bun run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^2.29.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "turbo": "^2.6.1",
    "typescript": "catalog:",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "packageManager": "bun@1.3.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Better-Tables/better-tables"
  },
  "keywords": [
    "react",
    "table",
    "data-grid",
    "filtering",
    "sorting",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
